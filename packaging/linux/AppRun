#!/bin/sh
# GTK libraries, modules and data belong to the AppImage; user drivers stay external.
set -eu
APPDIR=${APPDIR:-$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)}
export APPDIR
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules"
export GDK_PIXBUF_MODULEDIR="$APPDIR/usr/lib/gdk-pixbuf/loaders"
# A setup command is available without launching the UI or modifying the image.
if [ "${1:-}" = --setup-transfers ]; then
    shift
    exec python3 "$APPDIR/usr/share/sdbui/setup-transfers.py" "$@"
fi
cache=""
child=""
cleanup() { [ -z "$cache" ] || rm -rf "$cache"; }
forward() { [ -z "$child" ] || kill -TERM "$child" 2>/dev/null || true; }
trap cleanup EXIT
trap forward TERM INT HUP
if [ -x "$APPDIR/usr/bin/gdk-pixbuf-query-loaders" ]; then
    cache=$(mktemp -d "${TMPDIR:-/tmp}/sdbui-pixbuf.XXXXXX")
    export GDK_PIXBUF_MODULE_FILE="$cache/loaders.cache"
    "$APPDIR/usr/bin/gdk-pixbuf-query-loaders" > "$GDK_PIXBUF_MODULE_FILE"
fi
"$APPDIR/usr/bin/sdbui" "$@" &
child=$!
status=0
while kill -0 "$child" 2>/dev/null; do
    wait "$child" && status=0 || status=$?
done
exit "$status"
